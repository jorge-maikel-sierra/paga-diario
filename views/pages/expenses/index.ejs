<%
/**
 * Vista: expenses/index.ejs
 * Listado de gastos operativos con filtros y paginación.
 *
 * Variables locales esperadas:
 * - isCollector: boolean — true si el usuario autenticado es COLLECTOR
 * - expenses, collectors, total, totalAmount, page, totalPages, filters
 * - user, flashSucess, flashError
 */
function formatCOP(amount) {
  if (amount == null) return '$0';
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount);
}

function formatDate(date) {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('es-CO', {
    day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC',
  });
}

const CATEGORY_BADGE = {
  FUEL:           { bg: 'bg-blue-100',   text: 'text-blue-700',   emoji: '⛽', label: 'Combustible' },
  VEHICLE_REPAIR: { bg: 'bg-orange-100', text: 'text-orange-700', emoji: '🔧', label: 'Reparación' },
  FOOD:           { bg: 'bg-green-100',  text: 'text-green-700',  emoji: '🍽️', label: 'Comida' },
  OTHER:          { bg: 'bg-surface-hover', text: 'text-ink-secondary', emoji: '📋', label: 'Otro' },
};

function pageLink(p) {
  const params = new URLSearchParams();
  params.set('page', p);
  if (filters.dateFrom) params.set('dateFrom', filters.dateFrom);
  if (filters.dateTo) params.set('dateTo', filters.dateTo);
  if (filters.category) params.set('category', filters.category);
  if (!isCollector && filters.collectorId) params.set('collectorId', filters.collectorId);
  return '/admin/expenses?' + params.toString();
}
%>
<%- include('../../layouts/header') %>

<div class="p-4 sm:p-6 lg:p-8 space-y-6">

  <!-- =========================================
       ENCABEZADO
  ========================================= -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold text-ink"><%= isCollector ? 'Mis Gastos' : 'Gastos Operativos' %></h1>
      <p class="text-sm text-ink-secondary mt-1">
        <span class="font-medium text-ink"><%= total %></span>
        gasto<%= total !== 1 ? 's' : '' %> ·
        <span class="font-semibold text-ink"><%= formatCOP(totalAmount) %></span> en total
      </p>
    </div>
    <a href="/admin/expenses/new"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-brand-green text-white text-sm font-semibold shadow-sm hover:bg-green-500 transition-colors">
      ➕ Registrar Gasto
    </a>
  </div>

  <!-- Los mensajes flash los renderiza header.ejs → partials/_flash -->

  <!-- =========================================
       FORMULARIO DE FILTROS
  ========================================= -->
  <form method="GET" action="/admin/expenses"
        class="bg-surface rounded-xl border border-line shadow-sm p-5">
    <p class="text-xs font-semibold text-ink-secondary uppercase tracking-wide mb-4">🔍 Filtros</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 <%= isCollector ? 'lg:grid-cols-4' : 'lg:grid-cols-5' %> gap-4">

      <div>
        <label for="dateFrom" class="block text-xs font-medium text-ink-secondary mb-1">Fecha inicio</label>
        <input type="date" id="dateFrom" name="dateFrom" value="<%= filters.dateFrom %>"
               class="w-full px-3 py-2 rounded-lg border border-line text-sm text-ink focus:ring-2 focus:ring-brand-green focus:outline-none transition" />
      </div>

      <div>
        <label for="dateTo" class="block text-xs font-medium text-ink-secondary mb-1">Fecha fin</label>
        <input type="date" id="dateTo" name="dateTo" value="<%= filters.dateTo %>"
               class="w-full px-3 py-2 rounded-lg border border-line text-sm text-ink focus:ring-2 focus:ring-brand-green focus:outline-none transition" />
      </div>

      <div>
        <label for="category" class="block text-xs font-medium text-ink-secondary mb-1">Categoría</label>
        <select id="category" name="category"
                class="w-full px-3 py-2 rounded-lg border border-line text-sm text-ink bg-surface focus:ring-2 focus:ring-brand-green focus:outline-none transition">
          <option value="">— Todas —</option>
          <option value="FUEL" <%= filters.category === 'FUEL' ? 'selected' : '' %>>⛽ Combustible</option>
          <option value="VEHICLE_REPAIR" <%= filters.category === 'VEHICLE_REPAIR' ? 'selected' : '' %>>🔧 Reparación</option>
          <option value="FOOD" <%= filters.category === 'FOOD' ? 'selected' : '' %>>🍽️ Comida</option>
          <option value="OTHER" <%= filters.category === 'OTHER' ? 'selected' : '' %>>📋 Otro</option>
        </select>
      </div>

      <% if (!isCollector) { %>
        <div>
          <label for="collectorId" class="block text-xs font-medium text-ink-secondary mb-1">Cobrador</label>
          <select id="collectorId" name="collectorId"
                  class="w-full px-3 py-2 rounded-lg border border-line text-sm text-ink bg-surface focus:ring-2 focus:ring-brand-green focus:outline-none transition">
            <option value="">— Todos —</option>
            <% collectors.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= filters.collectorId === c.id ? 'selected' : '' %>>
                <%= c.firstName %> <%= c.lastName %>
              </option>
            <% }); %>
          </select>
        </div>
      <% } %>

      <div class="flex items-end">
        <button type="submit"
          class="w-full px-4 py-2 rounded-lg bg-action text-action-on text-sm font-semibold hover:bg-blue-900 transition-colors">
          🔍 Filtrar
        </button>
      </div>

    </div>

    <% if (filters.dateFrom || filters.dateTo || filters.category || (!isCollector && filters.collectorId)) { %>
      <div class="mt-3 flex justify-end">
        <a href="/admin/expenses" class="text-xs text-ink-muted hover:text-ink transition-colors">✕ Limpiar filtros</a>
      </div>
    <% } %>
  </form>

  <!-- =========================================
       TABLA DE GASTOS
  ========================================= -->
  <div class="bg-surface rounded-xl border border-line shadow-sm overflow-x-auto">

    <% if (expenses.length === 0) { %>
      <div class="py-16 text-center">
        <span class="text-4xl block mb-3">🧾</span>
        <p class="text-sm font-medium text-ink-secondary">No hay gastos para los filtros aplicados</p>
        <p class="text-xs text-ink-muted mt-1">Registra un gasto o prueba cambiando los filtros.</p>
      </div>
    <% } else { %>
      <table class="min-w-full text-sm">
        <thead class="bg-app border-b border-line">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-ink-secondary uppercase tracking-wide">Fecha</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-ink-secondary uppercase tracking-wide">Categoría</th>
            <% if (!isCollector) { %>
              <th class="px-4 py-3 text-left text-xs font-semibold text-ink-secondary uppercase tracking-wide">Cobrador</th>
            <% } %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-ink-secondary uppercase tracking-wide">Descripción</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Monto</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line-subtle">
          <% expenses.forEach(function(expense) { %>
            <%
              const catInfo = CATEGORY_BADGE[expense.category]
                || { bg: 'bg-surface-hover', text: 'text-ink-secondary', emoji: '📋', label: expense.category };
            %>
            <tr class="hover:bg-surface-hover transition-colors">
              <td class="px-4 py-3 text-ink-secondary whitespace-nowrap"><%= formatDate(expense.expenseDate) %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= catInfo.bg %> <%= catInfo.text %>">
                  <%= catInfo.emoji %> <%= catInfo.label %>
                </span>
              </td>
              <% if (!isCollector) { %>
                <td class="px-4 py-3 text-ink-secondary text-xs">
                  <%= expense.collector.firstName %> <%= expense.collector.lastName %>
                </td>
              <% } %>
              <td class="px-4 py-3 text-ink-secondary max-w-xs truncate"><%= expense.description || '—' %></td>
              <td class="px-4 py-3 text-right font-semibold text-ink tabular-nums"><%= formatCOP(expense.amount) %></td>
              <td class="px-4 py-3 text-right">
                <form method="POST" action="/admin/expenses/<%= expense.id %>?_method=DELETE"
                      onsubmit="return confirm('¿Eliminar este gasto?')">
                  <button type="submit" title="Eliminar"
                    class="p-1.5 rounded-md text-ink-muted hover:text-danger hover:bg-danger/10 transition-colors">
                    🗑️
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

  </div>

  <!-- =========================================
       PAGINACIÓN
  ========================================= -->
  <% if (totalPages > 1) { %>
    <div class="flex items-center justify-between px-1">
      <span class="text-xs text-ink-secondary">
        Página <span class="font-semibold text-ink"><%= page %></span>
        de <span class="font-semibold text-ink"><%= totalPages %></span>
      </span>
      <div class="flex items-center gap-2">
        <% if (page > 1) { %>
          <a href="<%= pageLink(page - 1) %>" class="px-4 py-2 rounded-lg border border-line text-sm font-medium text-ink-secondary hover:bg-surface-hover transition-colors">← Anterior</a>
        <% } else { %>
          <span class="px-4 py-2 rounded-lg border border-line-subtle text-sm font-medium text-ink-muted cursor-not-allowed">← Anterior</span>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="<%= pageLink(page + 1) %>" class="px-4 py-2 rounded-lg border border-line text-sm font-medium text-ink-secondary hover:bg-surface-hover transition-colors">Siguiente →</a>
        <% } else { %>
          <span class="px-4 py-2 rounded-lg border border-line-subtle text-sm font-medium text-ink-muted cursor-not-allowed">Siguiente →</span>
        <% } %>
      </div>
    </div>
  <% } %>

</div>

<%- include('../../layouts/footer') %>
