<%
  /**
   * Formatea un número como moneda colombiana.
   * @param {string|number} val
   * @returns {string}
   */
  const formatCOP = (val) => '$' + Number(val).toLocaleString('es-CO');
%>

<%- include('../layouts/header') %>

<div class="p-4 sm:p-6 lg:p-8 space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Resumen general de la operación</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="badge-success">
        <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
        En vivo
      </span>
      <span id="live-payments-badge"
        class="hidden inline-flex items-center justify-center w-6 h-6 rounded-full bg-danger text-white text-xs font-bold">
        0
      </span>
    </div>
  </div>

  <!-- KPI Cards Row 1: Financial -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Capital desembolsado</p>
        <span class="text-2xl">💰</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-ink tabular-nums"><%= formatCOP(kpis.totalDisbursed) %></p>
    </div>

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Total recaudado</p>
        <span class="text-2xl">📥</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-success tabular-nums"><%= formatCOP(kpis.totalCollected) %></p>
    </div>

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Saldo pendiente</p>
        <span class="text-2xl">🏦</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-warning tabular-nums"><%= formatCOP(kpis.totalOutstanding) %></p>
    </div>

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Mora acumulada</p>
        <span class="text-2xl">⚠️</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-danger tabular-nums"><%= formatCOP(kpis.totalMora) %></p>
    </div>

  </div>

  <!-- KPI Cards Row 2: Operational -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Préstamos activos</p>
        <span class="text-2xl">💳</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-ink tabular-nums"><%= kpis.activeLoans %></p>
    </div>

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Clientes</p>
        <span class="text-2xl">👥</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-ink tabular-nums"><%= kpis.totalClients %></p>
    </div>

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Cobradores activos</p>
        <span class="text-2xl">🧑‍💼</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-ink tabular-nums"><%= kpis.totalCollectors %></p>
    </div>

    <div class="card p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-ink-secondary">Recaudación hoy</p>
        <span class="text-2xl">📅</span>
      </div>
      <p class="mt-2 text-2xl font-display font-bold text-success tabular-nums"><%= formatCOP(kpis.todayCollected) %></p>
      <p class="mt-1 text-xs text-ink-muted"><%= kpis.todayPayments %> pagos registrados</p>
    </div>

  </div>

  <!-- Two-column section: Mora Alerts + Recent Payments -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Mora Alerts -->
    <div class="card">
      <div class="flex items-center justify-between p-5 border-b border-line-subtle">
        <div class="flex items-center gap-2">
          <span class="text-lg">🚨</span>
          <h2 class="text-lg font-display font-semibold text-ink">Alertas de mora</h2>
        </div>
        <span class="<%= kpis.overdueSchedules > 0 ? 'badge-danger' : 'badge-success' %> font-bold">
          <%= kpis.overdueSchedules %>
        </span>
      </div>

      <div class="divide-y divide-line-subtle max-h-80 overflow-y-auto">
        <% if (!kpis.moraAlerts || kpis.moraAlerts.length === 0) { %>
          <div class="p-8 text-center text-ink-muted text-sm">✅ No hay cuotas vencidas</div>
        <% } else { %>
          <% kpis.moraAlerts.forEach((alert) => {
            const client = alert.loan.client;
            const collector = alert.loan.collector;
            const dueDate = new Date(alert.dueDate).toLocaleDateString('es-CO');
            const daysOverdue = Math.floor((Date.now() - new Date(alert.dueDate).getTime()) / (1000 * 60 * 60 * 24));
            const owed = Number(alert.amountDue) - Number(alert.amountPaid);
          %>
            <div class="flex items-center justify-between px-5 py-3 hover:bg-surface-hover transition-colors">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-ink truncate"><%= client.firstName %> <%= client.lastName %></p>
                <p class="text-xs text-ink-secondary">Cuota #<%= alert.installmentNumber %> · Venció <%= dueDate %></p>
                <p class="text-xs text-ink-muted">Cobrador: <%= collector.firstName %> <%= collector.lastName %></p>
              </div>
              <div class="text-right ml-4 flex-shrink-0">
                <p class="text-sm font-bold text-danger tabular-nums"><%= formatCOP(owed) %></p>
                <span class="badge-danger"><%= daysOverdue %> días</span>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Recent Payments -->
    <div class="card">
      <div class="flex items-center justify-between p-5 border-b border-line-subtle">
        <div class="flex items-center gap-2">
          <span class="text-lg">💵</span>
          <h2 class="text-lg font-display font-semibold text-ink">Pagos recientes</h2>
        </div>
      </div>

      <div class="divide-y divide-line-subtle max-h-80 overflow-y-auto">
        <% if (!kpis.recentPayments || kpis.recentPayments.length === 0) { %>
          <div class="p-8 text-center text-ink-muted text-sm">No hay pagos registrados</div>
        <% } else { %>
          <% kpis.recentPayments.forEach((payment) => {
            const client = payment.loan.client;
            const collector = payment.collector;
            const dateStr = new Date(payment.collectedAt).toLocaleString('es-CO', {
              day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',
            });
          %>
            <div class="flex items-center justify-between px-5 py-3 hover:bg-surface-hover transition-colors">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-ink truncate"><%= client.firstName %> <%= client.lastName %></p>
                <p class="text-xs text-ink-secondary"><%= dateStr %> · <%= collector.firstName %> <%= collector.lastName %></p>
              </div>
              <p class="text-sm font-bold text-success ml-4 flex-shrink-0 tabular-nums"><%= formatCOP(payment.totalReceived) %></p>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

  </div>
</div>

<%- include('../layouts/footer') %>
