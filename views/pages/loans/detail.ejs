<%
const STATUS_MAP = {
  ACTIVE:    { bg: 'bg-green-100',  text: 'text-green-700',  label: 'Activo'      },
  PENDING:   { bg: 'bg-yellow-100', text: 'text-yellow-700', label: 'Pendiente'   },
  COMPLETED: { bg: 'bg-blue-100',   text: 'text-blue-700',   label: 'Completado'  },
  DEFAULTED: { bg: 'bg-red-100',    text: 'text-red-700',    label: 'En mora'     },
  CANCELLED: { bg: 'bg-surface-hover',   text: 'text-ink-secondary',   label: 'Cancelado'   },
};

const FREQ_MAP = {
  DAILY:    'Diario',
  WEEKLY:   'Semanal',
  BIWEEKLY: 'Quincenal',
  MONTHLY:  'Mensual',
};

const AMORT_MAP = {
  FIXED:             'Cuota fija',
  DECLINING_BALANCE: 'Saldo decreciente',
};

const INCIDENT_MAP = {
  CLIENT_ABSENT:     { icon: '🚪', label: 'Cliente ausente'   },
  PARTIAL_PAYMENT:   { icon: '💰', label: 'Pago parcial'      },
  REFUSED_PAYMENT:   { icon: '🚫', label: 'Se negó a pagar'   },
  ADDRESS_NOT_FOUND: { icon: '📍', label: 'Dirección no encontrada' },
};

function formatCOP(amount) {
  if (amount == null) return '—';
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount);
}

function formatDate(date) {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('es-CO', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function formatDateTime(date) {
  if (!date) return '—';
  return new Date(date).toLocaleString('es-CO', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'America/Bogota',
  });
}

const badge = STATUS_MAP[loan.status] || { bg: 'bg-surface-hover', text: 'text-ink-secondary', label: loan.status };

// Calcular progreso con clamp defensivo: si el préstamo está COMPLETED, mostrar 100%
let progressPct;
if (loan.status === 'COMPLETED') {
  progressPct = 100;
} else if (loan.numberOfPayments > 0) {
  progressPct = Math.round((loan.paidPayments / loan.numberOfPayments) * 100);
} else {
  progressPct = 0;
}
%>
<%- include('../../layouts/header') %>
<div class="p-4 sm:p-6 lg:p-8 space-y-6">

  <!-- Encabezado -->
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href="/admin/loans"
         class="inline-flex items-center gap-1 text-sm text-ink-muted hover:text-ink transition-colors">
        ← Préstamos
      </a>
      <span class="text-ink-muted">/</span>
      <span class="text-sm text-ink-secondary">
        <%= loan.client.firstName %> <%= loan.client.lastName %>
      </span>
    </div>
    <span class="inline-flex items-center self-start px-3 py-1 rounded-full text-sm font-semibold
                 <%= badge.bg %> <%= badge.text %>">
      <%= badge.label %>
    </span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold text-ink">
        Préstamo — <%= loan.client.firstName %> <%= loan.client.lastName %>
      </h1>
      <p class="text-xs text-ink-muted mt-0.5 font-mono"><%= loan.id %></p>
    </div>
  </div>

  <!-- KPIs rápidos -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

    <div class="bg-surface rounded-xl border border-line shadow-sm p-4">
      <p class="text-xs font-medium text-ink-secondary uppercase tracking-wide">Capital</p>
      <p class="text-xl font-bold text-ink mt-1"><%= formatCOP(loan.principalAmount) %></p>
    </div>

    <div class="bg-surface rounded-xl border border-line shadow-sm p-4">
      <p class="text-xs font-medium text-ink-secondary uppercase tracking-wide">Saldo pendiente</p>
      <p class="text-xl font-bold <%= loan.status === 'DEFAULTED' ? 'text-red-600' : 'text-ink' %> mt-1">
        <%= formatCOP(loan.outstandingBalance) %>
      </p>
    </div>

    <div class="bg-surface rounded-xl border border-line shadow-sm p-4">
      <p class="text-xs font-medium text-ink-secondary uppercase tracking-wide">Total pagado</p>
      <p class="text-xl font-bold text-green-600 mt-1"><%= formatCOP(loan.totalPaid) %></p>
    </div>

    <div class="bg-surface rounded-xl border border-line shadow-sm p-4">
      <p class="text-xs font-medium text-ink-secondary uppercase tracking-wide">Cuota</p>
      <p class="text-xl font-bold text-ink mt-1"><%= formatCOP(loan.installmentAmount) %></p>
      <p class="text-xs text-ink-muted mt-0.5"><%= FREQ_MAP[loan.paymentFrequency] || loan.paymentFrequency %></p>
    </div>

  </div>

  <!-- Progreso de cuotas -->
  <div class="bg-surface rounded-xl border border-line shadow-sm p-4">
    <div class="flex items-center justify-between mb-2">
      <p class="text-sm font-medium text-ink">Progreso de cuotas</p>
      <p class="text-sm font-semibold text-ink">
        <%= loan.paidPayments %> / <%= loan.numberOfPayments %>
        <span class="text-ink-muted font-normal ml-1">(<%= progressPct %>%)</span>
      </p>
    </div>
    <div class="w-full bg-surface-hover rounded-full h-2.5">
      <div class="bg-brand-green h-2.5 rounded-full transition-all"
           style="width: <%= progressPct %>%"></div>
    </div>
    <% if (loan.status === 'DEFAULTED' && loan.moraAmount && parseFloat(loan.moraAmount) > 0) { %>
      <p class="mt-2 text-xs font-medium text-red-600">
        ⚠️ Mora acumulada: <%= formatCOP(loan.moraAmount) %>
      </p>
    <% } %>
  </div>

  <!-- Datos generales + Datos del cliente -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

    <!-- Datos del préstamo -->
    <div class="bg-surface rounded-xl border border-line shadow-sm">
      <div class="px-5 py-3 border-b border-line-subtle">
        <h2 class="text-sm font-semibold text-ink uppercase tracking-wide">Datos del préstamo</h2>
      </div>
      <dl class="divide-y divide-line-subtle">
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Amortización</dt>
          <dd class="font-medium text-ink"><%= AMORT_MAP[loan.amortizationType] || loan.amortizationType %></dd>
        </div>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Tasa de interés</dt>
          <dd class="font-medium text-ink">
            <%= (parseFloat(loan.interestRate) * 100).toFixed(2) %>% por período
          </dd>
        </div>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Monto total</dt>
          <dd class="font-medium text-ink"><%= formatCOP(loan.totalAmount) %></dd>
        </div>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Fecha desembolso</dt>
          <dd class="font-medium text-ink"><%= formatDate(loan.disbursementDate) %></dd>
        </div>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Fecha fin esperada</dt>
          <dd class="font-medium text-ink"><%= formatDate(loan.expectedEndDate) %></dd>
        </div>
        <% if (loan.actualEndDate) { %>
          <div class="flex justify-between px-5 py-3 text-sm">
            <dt class="text-ink-secondary">Fecha fin real</dt>
            <dd class="font-medium text-green-600"><%= formatDate(loan.actualEndDate) %></dd>
          </div>
        <% } %>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Cobrador</dt>
          <dd class="font-medium text-ink">
            <%= loan.collector.firstName %> <%= loan.collector.lastName %>
          </dd>
        </div>
      </dl>
    </div>

    <!-- Datos del cliente -->
    <div class="bg-surface rounded-xl border border-line shadow-sm">
      <div class="px-5 py-3 border-b border-line-subtle flex items-center justify-between">
        <h2 class="text-sm font-semibold text-ink uppercase tracking-wide">Cliente</h2>
        <a href="/admin/clients/<%= loan.client.id %>"
           class="text-xs text-brand-green hover:underline font-medium">
          Ver perfil →
        </a>
      </div>
      <dl class="divide-y divide-line-subtle">
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Nombre</dt>
          <dd class="font-medium text-ink">
            <%= loan.client.firstName %> <%= loan.client.lastName %>
          </dd>
        </div>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Documento</dt>
          <dd class="font-medium text-ink">
            <%= loan.client.documentType %> <%= loan.client.documentNumber %>
          </dd>
        </div>
        <% if (loan.client.phone) { %>
          <div class="flex justify-between px-5 py-3 text-sm">
            <dt class="text-ink-secondary">Teléfono</dt>
            <dd class="font-medium text-ink"><%= loan.client.phone %></dd>
          </div>
        <% } %>
        <% if (loan.client.address) { %>
          <div class="flex justify-between px-5 py-3 text-sm">
            <dt class="text-ink-secondary">Dirección</dt>
            <dd class="font-medium text-ink text-right max-w-xs"><%= loan.client.address %></dd>
          </div>
        <% } %>
        <!-- businessName removed from loan client display -->
        <% if (loan.client.route) { %>
          <div class="flex justify-between px-5 py-3 text-sm">
            <dt class="text-ink-secondary">Ruta</dt>
            <dd class="font-medium text-ink"><%= loan.client.route.name %></dd>
          </div>
        <% } %>
        <div class="flex justify-between px-5 py-3 text-sm">
          <dt class="text-ink-secondary">Estado cliente</dt>
          <dd>
            <% if (loan.client.isActive) { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Activo</span>
            <% } else { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-600">Inactivo</span>
            <% } %>
          </dd>
        </div>
      </dl>
    </div>

  </div>

  <!-- Cronograma de pagos -->
  <div class="bg-surface rounded-xl border border-line shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-line-subtle flex items-center justify-between">
      <h2 class="text-sm font-semibold text-ink uppercase tracking-wide">
        Cronograma de cuotas
      </h2>
      <%
        const activeSched    = loan.paymentSchedule.filter(s => !s.isRestructured);
        const paidSched      = activeSched.filter(s => s.isPaid);
        const restructSched  = loan.paymentSchedule.filter(s => s.isRestructured);
      %>
      <span class="text-xs text-ink-muted">
        <%= paidSched.length %> pagadas / <%= activeSched.length %> activas
        <% if (restructSched.length > 0) { %>
          · <span class="text-purple-500"><%= restructSched.length %> restructuradas</span>
        <% } %>
      </span>
    </div>

    <%
      /**
       * Invariante financiero: totalPaid + outstandingBalance ≈ totalAmount
       *
       * outstandingBalance = totalAmount - totalPaid en todos los tipos de pago.
       * Una diferencia > $1 indica inconsistencia en la BD (ej: migración manual
       * incorrecta o bug en el engine de pagos).
       */
      const balanceCheck = Math.abs(
        (parseFloat(loan.totalPaid) + parseFloat(loan.outstandingBalance)) - parseFloat(loan.totalAmount)
      ) < 1;
    %>

    <% if (loan.paymentSchedule.length === 0) { %>
      <div class="py-8 text-center text-ink-muted text-sm">
        No hay cronograma generado para este préstamo.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-line text-sm">
          <thead class="bg-app">
            <tr>
              <th class="px-4 py-2.5 text-center text-xs font-semibold text-ink-secondary uppercase tracking-wide w-12">#</th>
              <th class="px-4 py-2.5 text-center text-xs font-semibold text-ink-secondary uppercase tracking-wide">Vencimiento</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Capital</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Interés</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Cuota</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Pagado</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Mora</th>
              <th class="px-4 py-2.5 text-center text-xs font-semibold text-ink-secondary uppercase tracking-wide">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-subtle">
            <% loan.paymentSchedule.forEach(function(schedule) {
              const isOverdue = !schedule.isPaid && !schedule.isRestructured && new Date(schedule.dueDate) < new Date();
              let rowClass = 'hover:bg-surface-hover transition-colors';
              if (schedule.isPaid)         rowClass = 'bg-success/10 hover:bg-success/15 transition-colors';
              else if (schedule.isRestructured) rowClass = 'bg-purple-500/10 opacity-60';
              else if (isOverdue)          rowClass = 'bg-danger/10 hover:bg-danger/15 transition-colors';
            %>
              <tr class="<%= rowClass %>">
                <td class="px-4 py-2.5 text-center text-ink-secondary font-mono text-xs">
                  <%= schedule.installmentNumber %>
                </td>
                <td class="px-4 py-2.5 text-center text-ink">
                  <%= formatDate(schedule.dueDate) %>
                  <% if (isOverdue) { %>
                    <span class="ml-1 badge-danger font-medium">Vencida</span>
                  <% } %>
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums text-ink"><%= formatCOP(schedule.principalDue) %></td>
                <td class="px-4 py-2.5 text-right tabular-nums text-ink"><%= formatCOP(schedule.interestDue) %></td>
                <td class="px-4 py-2.5 text-right tabular-nums font-medium text-ink"><%= formatCOP(schedule.amountDue) %></td>
                <td class="px-4 py-2.5 text-right tabular-nums text-green-600">
                  <%= parseFloat(schedule.amountPaid) > 0 ? formatCOP(schedule.amountPaid) : '—' %>
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums text-red-500">
                  <%= parseFloat(schedule.moraCharged) > 0 ? formatCOP(schedule.moraCharged) : '—' %>
                </td>
                <td class="px-4 py-2.5 text-center">
                  <% if (schedule.isPaid) { %>
                    <span class="badge-success">✓ Pagada</span>
                  <% } else if (schedule.isRestructured) { %>
                    <span class="badge bg-purple-500/10 text-purple-600">↺ Restructurada</span>
                  <% } else if (isOverdue) { %>
                    <span class="badge-danger">⚠ Vencida</span>
                  <% } else { %>
                    <span class="badge-warning">Pendiente</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Leyenda de estados del cronograma -->
      <div class="px-5 py-3 border-t border-line-subtle flex flex-wrap gap-4 text-xs text-ink-secondary">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-green-400 inline-block"></span> Pagada
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 inline-block"></span> Pendiente
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block"></span> Vencida
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400 inline-block"></span>
          Restructurada (abono anticipado a capital)
        </span>
      </div>

      <!-- Alerta de invariante financiero roto (indica inconsistencia en BD) -->
      <% if (!balanceCheck) { %>
        <div class="px-5 py-3 bg-danger/10 border-t border-danger/20">
          <p class="text-xs font-medium text-danger">
            ⚠ Inconsistencia detectada: el saldo pendiente no coincide con el capital
            del cronograma activo. Contacta al soporte técnico.
          </p>
        </div>
      <% } %>
    <% } %>
  </div>

  <!-- Últimos pagos registrados -->
  <div class="bg-surface rounded-xl border border-line shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-line-subtle">
      <h2 class="text-sm font-semibold text-ink uppercase tracking-wide">
        Pagos registrados
        <% if (loan.payments.length > 0) { %>
          <span class="ml-1 text-ink-muted font-normal normal-case text-xs">
            (últimos <%= loan.payments.length %>)
          </span>
        <% } %>
      </h2>
    </div>

    <%
      /**
       * Mapa de tipos de pago del engine para mostrar una etiqueta descriptiva.
       * Refleja los PaymentType definidos en payment-split.js.
       */
      const PAYMENT_TYPE_MAP = {
        PARTIAL_INTEREST: { bg: 'bg-orange-100', text: 'text-orange-700', label: 'Parcial'        },
        INTEREST_ONLY:    { bg: 'bg-blue-100',   text: 'text-blue-700',   label: 'Solo interés'   },
        FULL:             { bg: 'bg-green-100',  text: 'text-green-700',  label: 'Cuota completa' },
        OVERPAYMENT:      { bg: 'bg-purple-100', text: 'text-purple-700', label: 'Abono anticipado'},
        PAYOFF:           { bg: 'bg-teal-100',   text: 'text-teal-700',   label: 'Liquidación'    },
      };
    %>

    <% if (loan.payments.length === 0) { %>
      <div class="py-8 text-center text-ink-muted text-sm">
        No hay pagos registrados aún.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-line text-sm">
          <thead class="bg-app">
            <tr>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-ink-secondary uppercase tracking-wide">Fecha</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Capital aplicado</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Interés aplicado</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Mora</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-ink-secondary uppercase tracking-wide">Total recibido</th>
              <th class="px-4 py-2.5 text-center text-xs font-semibold text-ink-secondary uppercase tracking-wide">Tipo</th>
              <th class="px-4 py-2.5 text-center text-xs font-semibold text-ink-secondary uppercase tracking-wide">Método</th>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-ink-secondary uppercase tracking-wide">Cobrador</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-subtle">
            <% loan.payments.forEach(function(payment) {
              const typeInfo = PAYMENT_TYPE_MAP[payment.paymentType] || { bg: 'bg-surface-hover', text: 'text-ink-secondary', label: payment.paymentType || '—' };
            %>
              <tr class="hover:bg-surface-hover transition-colors">
                <td class="px-4 py-2.5 text-ink whitespace-nowrap"><%= formatDateTime(payment.collectedAt) %></td>
                <td class="px-4 py-2.5 text-right tabular-nums text-ink font-medium">
                  <%= parseFloat(payment.principalApplied) > 0 ? formatCOP(payment.principalApplied) : '—' %>
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums text-blue-600">
                  <%= parseFloat(payment.interestApplied) > 0 ? formatCOP(payment.interestApplied) : '—' %>
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums text-red-500">
                  <%= parseFloat(payment.moraAmount) > 0 ? formatCOP(payment.moraAmount) : '—' %>
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums font-semibold text-green-600"><%= formatCOP(payment.totalReceived) %></td>
                <td class="px-4 py-2.5 text-center">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                               <%= typeInfo.bg %> <%= typeInfo.text %>">
                    <%= typeInfo.label %>
                  </span>
                </td>
                <td class="px-4 py-2.5 text-center">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-surface-hover text-ink-secondary">
                    <%= payment.paymentMethod %>
                  </span>
                </td>
                <td class="px-4 py-2.5 text-ink whitespace-nowrap">
                  <%= payment.collector.firstName %> <%= payment.collector.lastName %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Incidentes -->
  <% if (loan.incidents.length > 0) { %>
    <div class="bg-surface rounded-xl border border-line shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-line-subtle">
        <h2 class="text-sm font-semibold text-ink uppercase tracking-wide">
          Incidentes
          <span class="ml-1 inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-100 text-red-600 text-xs font-bold">
            <%= loan.incidents.length %>
          </span>
        </h2>
      </div>
      <ul class="divide-y divide-line-subtle">
        <% loan.incidents.forEach(function(incident) {
          const inc = INCIDENT_MAP[incident.type] || { icon: '⚠️', label: incident.type };
        %>
          <li class="flex items-start gap-3 px-5 py-3">
            <span class="text-xl mt-0.5"><%= inc.icon %></span>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-ink"><%= inc.label %></p>
              <% if (incident.description) { %>
                <p class="text-xs text-ink-secondary mt-0.5"><%= incident.description %></p>
              <% } %>
              <p class="text-xs text-ink-muted mt-1">
                <%= formatDateTime(incident.reportedAt) %> ·
                <%= incident.collector.firstName %> <%= incident.collector.lastName %>
              </p>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Notas -->
  <% if (loan.notes) { %>
    <div class="bg-warning/10 border border-warning/20 rounded-xl px-5 py-4">
      <p class="text-xs font-semibold text-warning uppercase tracking-wide mb-1">📝 Notas internas</p>
      <p class="text-sm text-warning"><%= loan.notes %></p>
    </div>
  <% } %>

</div>

<%- include('../../layouts/footer') %>
