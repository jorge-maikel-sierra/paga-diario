<%
  const STATUS_BADGE = {
    PENDING: 'badge-neutral',
    PROCESSING: 'badge-info',
    COMPLETED: 'badge-success',
    COMPLETED_WITH_ERRORS: 'badge-warning',
    FAILED: 'badge-danger',
  };
  const STATUS_LABEL = {
    PENDING: 'Pendiente de confirmar',
    PROCESSING: 'Procesando',
    COMPLETED: 'Completada',
    COMPLETED_WITH_ERRORS: 'Con errores',
    FAILED: 'Falló',
  };
  const formatDateTime = (date) => new Date(date).toLocaleString('es-CO', {
    day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit',
  });
%>
<%- include('../../../layouts/header') %>

<div class="p-4 sm:p-6 lg:p-8 space-y-6">

  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <a href="/admin/imports" class="btn-back">←</a>
      <div>
        <h1 class="page-title">Historial de Importaciones</h1>
        <p class="page-subtitle">Lotes de importación de tu organización</p>
      </div>
    </div>
    <a href="/admin/imports" class="btn-primary whitespace-nowrap">+ Nueva importación</a>
  </div>

  <% if (batches.length === 0) { %>
    <div class="card py-20 text-center">
      <span class="text-5xl block mb-4">📥</span>
      <p class="text-base font-semibold text-ink-secondary">Todavía no importaste ningún archivo</p>
      <a href="/admin/imports" class="mt-5 inline-flex btn-primary">+ Nueva importación</a>
    </div>
  <% } else { %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr>
              <th class="text-left">Archivo</th>
              <th class="text-left">Usuario</th>
              <th class="text-center">Filas</th>
              <th class="text-center">Éxito</th>
              <th class="text-center">Errores</th>
              <th class="text-center">Estado</th>
              <th class="text-left">Fecha</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% batches.forEach((batch) => { %>
              <tr>
                <td class="font-medium text-ink"><%= batch.fileName %></td>
                <td class="text-ink-secondary"><%= batch.user.firstName %> <%= batch.user.lastName %></td>
                <td class="text-center tabular-nums"><%= batch.totalRows %></td>
                <td class="text-center tabular-nums text-success"><%= batch.successRows %></td>
                <td class="text-center tabular-nums <%= batch.errorRows > 0 ? 'text-danger' : 'text-ink-muted' %>"><%= batch.errorRows %></td>
                <td class="text-center">
                  <span class="<%= STATUS_BADGE[batch.status] %>"><%= STATUS_LABEL[batch.status] %></span>
                </td>
                <td class="text-ink-secondary whitespace-nowrap"><%= formatDateTime(batch.createdAt) %></td>
                <td class="text-right">
                  <a href="/admin/imports/<%= batch.id %>" class="text-brand text-xs font-semibold hover:underline whitespace-nowrap">
                    Ver detalle →
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
        <div class="px-5 py-3 border-t border-line-subtle flex items-center justify-between text-sm text-ink-secondary">
          <span>Página <%= page %> de <%= totalPages %></span>
          <div class="flex gap-2">
            <% if (page > 1) { %>
              <a href="/admin/imports/history?page=<%= page - 1 %>" class="btn-secondary !px-3 !py-1.5 text-xs">← Anterior</a>
            <% } %>
            <% if (page < totalPages) { %>
              <a href="/admin/imports/history?page=<%= page + 1 %>" class="btn-secondary !px-3 !py-1.5 text-xs">Siguiente →</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<%- include('../../../layouts/footer') %>
