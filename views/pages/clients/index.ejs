<%- include('../../layouts/header') %>

<div class="p-4 sm:p-6 lg:p-8 space-y-6">

  <!-- Los mensajes flash los renderiza header.ejs → partials/_flash -->

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-ink">Clientes</h1>
      <p class="text-sm text-ink-secondary mt-1">
        <%= clients.length %> cliente<%= clients.length !== 1 ? 's' : '' %> encontrado<%= clients.length !== 1 ? 's' : '' %>
      </p>
    </div>

    <div class="flex items-center gap-3">
      <!-- Búsqueda -->
      <form action="/admin/clients" method="GET" class="w-full sm:w-auto">
        <div class="flex items-center gap-2">
          <input
            type="text"
            name="search"
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            placeholder="Nombre, cédula o teléfono..."
            class="w-full sm:w-72 px-4 py-2 rounded-lg border border-line
                   bg-surface text-sm text-ink
                   focus:ring-2 focus:ring-brand-green focus:outline-none transition"
          />
          <button type="submit"
            class="px-4 py-2 rounded-lg bg-brand-green text-white text-sm font-semibold
                   shadow-sm hover:bg-green-500 transition-colors whitespace-nowrap">
            🔍 Buscar
          </button>
          <% if (typeof search !== 'undefined' && search) { %>
            <a href="/admin/clients"
              class="px-3 py-2 rounded-lg border border-line text-sm text-ink-secondary
                     hover:bg-surface-hover transition-colors">
              ✕
            </a>
          <% } %>
        </div>
      </form>

      <!-- Botón Nuevo Cliente -->
      <a href="/admin/clients/new"
         class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-action text-action-on
                text-sm font-semibold shadow-sm hover:bg-action-hover transition-colors whitespace-nowrap">
        ➕ Nuevo Cliente
      </a>
    </div>
  </div>

  <!-- Tabla -->
  <div class="bg-surface rounded-xl border border-line shadow-sm overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-app">
        <tr>
          <th class="px-4 py-3 text-left font-semibold text-ink">Cliente</th>
          <th class="px-4 py-3 text-left font-semibold text-ink">Documento</th>
          <th class="px-4 py-3 text-left font-semibold text-ink">Teléfono</th>
          <th class="px-4 py-3 text-left font-semibold text-ink">Dirección</th>
          <th class="px-4 py-3 text-left font-semibold text-ink">Préstamos</th>
          <th class="px-4 py-3 text-left font-semibold text-ink">Estado</th>
          <th class="px-4 py-3 text-left font-semibold text-ink">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (clients.length === 0) { %>
          <tr>
            <td colspan="7" class="px-4 py-10 text-center text-ink-muted">
              <span class="text-4xl block mb-3">👥</span>
              <p class="font-medium">No se encontraron clientes</p>
              <% if (typeof search !== 'undefined' && search) { %>
                <p class="text-xs mt-1">Intenta con otro término de búsqueda</p>
              <% } %>
            </td>
          </tr>
        <% } else { %>
          <% clients.forEach(client => { %>
            <tr class="border-t border-line-subtle hover:bg-surface-hover transition-colors">
              <td class="px-4 py-3">
                <a href="/admin/clients/<%= client.id %>/edit"
                  class="font-medium text-ink hover:underline">
                  <%= client.firstName %> <%= client.lastName %>
                </a>
                <!-- businessName removed from list -->
              </td>
              <td class="px-4 py-3 text-ink-secondary">
                <span class="text-xs text-ink-muted"><%= client.documentType %></span>
                <%= client.documentNumber %>
              </td>
              <td class="px-4 py-3 text-ink-secondary">
                <%= client.phone || '—' %>
              </td>
              <td class="px-4 py-3 text-ink-secondary max-w-[180px] truncate">
                <%= client.address || '—' %>
              </td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full
                  text-xs font-bold
                  <%= client._count.loans > 0 ? 'bg-blue-100 text-blue-700' : 'bg-surface-hover text-ink-secondary' %>">
                  <%= client._count.loans %>
                </span>
              </td>
              <td class="px-4 py-3">
                <% if (client.isActive) { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                    ● Activo
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">
                    ● Restringido
                  </span>
                <% } %>
              </td>
              <td class="px-4 py-3">
                <a href="/admin/clients/<%= client.id %>/edit"
                  class="text-brand-green hover:underline text-sm font-medium">
                  ✏️ Editar
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

<%- include('../../layouts/footer') %>
