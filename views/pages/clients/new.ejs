<%
/**
 * Vista: clients/new.ejs
 * Formulario para crear un nuevo cliente.
 *
 * Variables locales esperadas:
 * - user: Usuario autenticado
 * - routes: Lista de rutas disponibles
 * - flashError: Mensaje de error opcional
 */

const DOCUMENT_OPTIONS = [
  { value: 'CC', label: 'Cédula de Ciudadanía' },
  { value: 'NIT', label: 'NIT' },
  { value: 'PEP', label: 'PEP' },
];
%>
<%- include('../../layouts/header') %>

<div class="p-4 sm:p-6 lg:p-8 space-y-6">

  <!-- =========================================
       ENCABEZADO
  ========================================= -->
  <div class="flex items-center gap-4">
    <a href="/admin/clients"
       class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-line
              text-ink-secondary hover:bg-surface-hover transition-colors">
      ←
    </a>
    <div>
      <h1 class="text-2xl font-bold text-ink">Crear Nuevo Cliente</h1>
      <p class="text-sm text-ink-secondary mt-1">Registra un cliente en tu organización</p>
    </div>
  </div>

  <!-- =========================================
       MENSAJE DE ERROR
  ========================================= -->
  <% if (typeof flashError !== 'undefined' && flashError) { %>
    <div class="flash-error" role="alert">
      <div class="flex items-center gap-2">
        <span class="text-danger text-lg shrink-0">❌</span>
        <p class="flash-error-text"><%= flashError %></p>
      </div>
    </div>
  <% } %>

  <!-- =========================================
       FORMULARIO
  ========================================= -->
  <form method="POST" action="/admin/clients"
    class="form-card max-w-5xl">

    <!-- Información Personal -->
    <div class="form-section">
      <h2 class="form-section-title">👤 Información Personal</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

        <!-- Nombre -->
        <div class="form-group">
          <label for="firstName" class="form-label">
            Nombre <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="firstName"
            name="firstName"
            required
            minlength="1"
            maxlength="80"
            placeholder="Ej: Juan"
            class="form-input"
          />
        </div>

        <!-- Apellido -->
        <div class="form-group">
          <label for="lastName" class="form-label">
            Apellido <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="lastName"
            name="lastName"
            required
            minlength="1"
            maxlength="80"
            placeholder="Ej: Pérez García"
            class="form-input"
          />
        </div>

        <!-- Tipo de Documento -->
        <div class="form-group">
          <label for="documentType" class="form-label">
            Tipo de Documento <span class="text-red-500">*</span>
          </label>
          <select
            id="documentType"
            name="documentType"
            required
            class="form-select"
          >
            <% DOCUMENT_OPTIONS.forEach(opt => { %>
              <option value="<%= opt.value %>" <%= opt.value === 'CC' ? 'selected' : '' %>>
                <%= opt.label %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Número de Documento -->
        <div class="form-group">
          <label for="documentNumber" class="form-label">
            Número de Documento <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            oninput="this.value = this.value.replace(/\D/g, '')"
            title="Solo dígitos"
            id="documentNumber"
            name="documentNumber"
            required
            minlength="5"
            maxlength="20"
            placeholder="Ej: 1234567890"
            class="form-input"
          />
        </div>

        <!-- Teléfono -->
        <div class="form-group">
          <label for="phone" class="form-label">Teléfono</label>
          <input
            type="tel"
            inputmode="numeric"
            pattern="[0-9]*"
            oninput="this.value = this.value.replace(/\D/g, '')"
            title="Solo dígitos"
            id="phone"
            name="phone"
            maxlength="20"
            placeholder="+57 300 123 4567"
            class="form-input"
          />
        </div>

        <!-- Ruta -->
        <div class="form-group">
          <label for="routeId" class="form-label">Ruta de Cobro</label>
          <select
            id="routeId"
            name="routeId"
            class="form-select"
          >
            <option value="">Sin asignar</option>
            <% routes.forEach(route => { %>
              <option value="<%= route.id %>"><%= route.name %></option>
            <% }); %>
          </select>
        </div>

      </div>
    </div>

    <!-- Ubicación -->
    <div class="form-section">
      <h2 class="form-section-title">📍 Ubicación</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

        <!-- Dirección -->
        <div class="form-group">
          <label for="address" class="form-label">
            Dirección <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="address"
            name="address"
            required
            maxlength="255"
            placeholder="Ej: Calle 15 # 20-45, Barrio Centro"
            class="form-input"
          />
        </div>

        <!-- Barrio -->
        <div class="form-group">
          <label for="neighborhood" class="form-label">Barrio</label>
          <input
            type="text"
            id="neighborhood"
            name="neighborhood"
            maxlength="100"
            placeholder="Ej: Centro"
            class="form-input"
          />
        </div>

        <!-- Ciudad -->
        <div class="form-group">
          <label for="city" class="form-label">Ciudad</label>
          <input
            type="text"
            id="city"
            name="city"
            maxlength="100"
            value="Riohacha"
            placeholder="Ej: Riohacha"
            class="form-input"
          />
        </div>

      </div>
    </div>

    <!-- Botones de Acción -->
    <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-line-subtle">
      <button type="submit" class="w-full sm:w-auto btn-primary">
        💾 Crear Cliente
      </button>
      <a href="/admin/clients" class="w-full sm:w-auto btn-secondary justify-center">
        Cancelar
      </a>
    </div>

  </form>

</div>

<%- include('../../layouts/footer') %>